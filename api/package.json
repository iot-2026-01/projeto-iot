{
    "name": "smart-load-balancing-api",
    "version": "1.0.0",
    "description": "Backend API for Smart Load Balancing System",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn src/index.ts",
        "test": "jest --testPathPattern=src/"
    },
    "keywords": [
        "iot",
        "load-balancing",
        "smart-system"
    ],
    "author": "Smart Load Balancing Team",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/helmet": "^0.0.46",
        "cors": "^2.8.5",
        "express": "^4.21.0",
        "helmet": "^7.1.0",
        "mqtt": "^5.10.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.2",
        "fast-check": "^4.8.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.4"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/src/tests/**/*.test.ts"
        ]
    }
}
